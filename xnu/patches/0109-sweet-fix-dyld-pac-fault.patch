diff --git a/bsd/vm/vm_unix.c b/bsd/vm/vm_unix.c
index 41982bc..7ecb136 100644
--- a/bsd/vm/vm_unix.c
+++ b/bsd/vm/vm_unix.c
@@ -2135,6 +2135,9 @@ shared_region_check_np(
 
 				/* ... and give it to the caller */
 				if (error == 0) {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+					start_address &= 0x00007fffffffffffULL;
+#endif
 					error = copyout(&start_address,
 					    (user_addr_t) uap->start_address,
 					    sizeof(start_address));
@@ -2974,8 +2977,14 @@ shared_region_map_and_slide_2_np(
 				goto done;
 			}
 			mappings[m].sms_address += slide_amount;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+			mappings[m].sms_address &= 0x00007fffffffffffULL;
+#endif
 			if (mappings[m].sms_slide_size != 0) {
 				mappings[m].sms_slide_start += slide_amount;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+				mappings[m].sms_slide_start &= 0x00007fffffffffffULL;
+#endif
 			}
 		}
 	}
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index bf796d6..34626ca 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -731,6 +731,26 @@ sleh_synchronous(arm_context_t *context, uint32_t esr, vm_offset_t far)
 		break;
 
 	case ESR_EC_DABORT_EL0:
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		if ((far & 0xffff800000000000ULL) != 0) {
+			bool fixed = false;
+			for (int i = 0; i < 31; i++) {
+				uint64_t reg = (uint64_t)get_saved_state_reg(state, i);
+				if ((reg & 0xffff800000000000ULL) != 0) {
+					set_saved_state_reg(state, i, reg & 0x00007fffffffffffULL);
+					fixed = true;
+				}
+			}
+			uint64_t sp = (uint64_t)get_saved_state_sp(state);
+			if ((sp & 0xffff800000000000ULL) != 0) {
+				set_saved_state_sp(state, sp & 0x00007fffffffffffULL);
+				fixed = true;
+			}
+			if (fixed) {
+				thread_exception_return();
+			}
+		}
+#endif
 		handle_abort(state, esr, far, inspect_data_abort, handle_user_abort, expected_fault_handler);
 		break;
 
@@ -752,6 +772,12 @@ sleh_synchronous(arm_context_t *context, uint32_t esr, vm_offset_t far)
 #endif /* __has_feature(ptrauth_calls) */
 
 	case ESR_EC_IABORT_EL0:
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		if ((far & 0xffff800000000000ULL) != 0) {
+			set_saved_state_pc(state, far & 0x00007fffffffffffULL);
+			thread_exception_return();
+		}
+#endif
 		handle_abort(state, esr, far, inspect_instruction_abort, handle_user_abort, expected_fault_handler);
 		break;
 
