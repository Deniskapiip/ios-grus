diff --git a/bsd/vm/vm_unix.c b/bsd/vm/vm_unix.c
index 41982bc..08841ce 100644
--- a/bsd/vm/vm_unix.c
+++ b/bsd/vm/vm_unix.c
@@ -2135,6 +2135,9 @@ shared_region_check_np(
 
 				/* ... and give it to the caller */
 				if (error == 0) {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+					start_address &= 0x0000000fffffffffULL;
+#endif
 					error = copyout(&start_address,
 					    (user_addr_t) uap->start_address,
 					    sizeof(start_address));
@@ -2974,8 +2977,14 @@ shared_region_map_and_slide_2_np(
 				goto done;
 			}
 			mappings[m].sms_address += slide_amount;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+			mappings[m].sms_address &= 0x0000000fffffffffULL;
+#endif
 			if (mappings[m].sms_slide_size != 0) {
 				mappings[m].sms_slide_start += slide_amount;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+				mappings[m].sms_slide_start &= 0x0000000fffffffffULL;
+#endif
 			}
 		}
 	}
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index bf796d6..8a91310 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -731,6 +731,24 @@ sleh_synchronous(arm_context_t *context, uint32_t esr, vm_offset_t far)
 		break;
 
 	case ESR_EC_DABORT_EL0:
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		if ((far & 0xffff800000000000ULL) != 0 || far >= 0x0000008000000000ULL) {
+			uint64_t pc = (uint64_t)get_saved_state_pc(state);
+			uint32_t instr = 0;
+			if (COPYIN((user_addr_t)pc, &instr, sizeof(instr)) == 0) {
+				int rt1 = instr & 0x1f;
+				int rt2 = (instr >> 10) & 0x1f;
+				if (rt1 < 31) {
+					set_saved_state_reg(state, rt1, 0);
+				}
+				if (rt2 < 31 && ((instr >> 25) & 0x7f) == 0x14) {
+					set_saved_state_reg(state, rt2, 0);
+				}
+			}
+			set_saved_state_pc(state, pc + 4);
+			thread_exception_return();
+		}
+#endif
 		handle_abort(state, esr, far, inspect_data_abort, handle_user_abort, expected_fault_handler);
 		break;
 
@@ -752,6 +770,12 @@ sleh_synchronous(arm_context_t *context, uint32_t esr, vm_offset_t far)
 #endif /* __has_feature(ptrauth_calls) */
 
 	case ESR_EC_IABORT_EL0:
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		if ((far & 0xffff800000000000ULL) != 0 || far >= 0x0000008000000000ULL) {
+			set_saved_state_pc(state, far & 0x0000000fffffffffULL);
+			thread_exception_return();
+		}
+#endif
 		handle_abort(state, esr, far, inspect_instruction_abort, handle_user_abort, expected_fault_handler);
 		break;
 
