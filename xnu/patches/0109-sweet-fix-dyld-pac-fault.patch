--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -733,6 +733,23 @@
 		break;
 
 	case ESR_EC_DABORT_EL0:
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		if ((far & 0xffff800000000000ULL) != 0 || far >= 0x00007ffffffff000ULL) {
+			uint64_t pc = (uint64_t)get_saved_state_pc(state);
+			for (int i = 0; i < 31; i++) {
+				uint64_t reg = (uint64_t)get_saved_state_reg(state, i);
+				if ((reg & 0xffff800000000000ULL) != 0 || reg >= 0x00007ffffffff000ULL) {
+					set_saved_state_reg(state, i, 0);
+				}
+			}
+			set_saved_state_pc(state, pc + 4);
+			thread_exception_return();
+		}
+#endif
 		handle_abort(state, esr, far, inspect_data_abort, handle_user_abort, expected_fault_handler);
 		break;
 
@@ -754,6 +771,14 @@
 	case ESR_EC_IABORT_EL0:
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		if ((far & 0xffff800000000000ULL) != 0 || far >= 0x00007ffffffff000ULL) {
+			set_saved_state_pc(state, far & 0x00007fffffffffffULL);
+			thread_exception_return();
+		}
+#endif
 		handle_abort(state, esr, far, inspect_instruction_abort, handle_user_abort, expected_fault_handler);
 		break;
 
--- a/bsd/vm/vm_unix.c
+++ b/bsd/vm/vm_unix.c
@@ -2150,6 +2150,9 @@
 
 				/* ... and give it to the caller */
 				if (error == 0) {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+					start_address &= 0x00007fffffffffffULL;
+#endif
 					error = copyout(&start_address,
 					    (user_addr_t) uap->start_address,
 					    sizeof(start_address));
@@ -2989,8 +2992,14 @@
 				goto done;
 			}
 			mappings[m].sms_address += slide_amount;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+			mappings[m].sms_address &= 0x00007fffffffffffULL;
+#endif
 			if (mappings[m].sms_slide_size != 0) {
 				mappings[m].sms_slide_start += slide_amount;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+				mappings[m].sms_slide_start &= 0x00007fffffffffffULL;
+#endif
 			}
 		}
 	}
