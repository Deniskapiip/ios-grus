diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index 162360c..af7082d 100755
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -385,6 +385,38 @@ static inline int sweet_entry_seq(void) { return 0; }
 static inline void sweet_entry_beacon(int idx, uint32_t color) { (void)idx; (void)color; }
 #endif
 
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET milestones: one 60x60 square per boot milestone, in a single row in
+ * the middle of the screen, each its own colour. Write-only, no console, no
+ * second source of output - the only thing on the glass that cannot lie.
+ */
+#include <console/video_console.h>
+extern struct vc_info vinfo;
+
+static void
+sweet_milestone(int slot, uint32_t color)
+{
+	static volatile uint32_t *fb;
+
+	if (fb == 0 && vinfo.v_baseaddr != 0) {
+		fb = (volatile uint32_t *)vinfo.v_baseaddr;
+	}
+	if (fb == 0) {
+		return;
+	}
+	for (int y = 0; y < 60; y++) {
+		for (int x = 0; x < 60; x++) {
+			fb[(1200 + y) * 1080 + slot * 70 + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#else
+static inline void sweet_milestone(int slot, uint32_t color) { (void)slot; (void)color; }
+#endif
+
 static void
 kernel_startup_log(startup_subsystem_id_t subsystem)
 {
@@ -738,6 +770,9 @@ kernel_bootstrap_thread(void)
 #ifdef  IOKIT
 	kernel_bootstrap_log("PE_init_iokit");
 	PE_init_iokit();
+	if (startup_phase >= STARTUP_SUB_KPRINTF) {
+		sweet_milestone(0, 0xff00ff00u);
+	}
 #endif
 
