@@ -473,10 +473,44 @@ bsd_rooted_ramdisk(void)
  * of the tro_ucred field so that the uthread structure can be
  * used like any other.
  */
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET boot beacons: write-only colour squares at the bottom of the screen,
+ * one per milestone. Writing needs no framebuffer read, so this works even
+ * while the console cannot scroll.
+ */
+#include <console/video_console.h>
+/* the video console already mapped it: reuse, never map twice */
+extern struct vc_info vinfo;
+
+static void
+sweet_beacon(int idx, uint32_t color)
+{
+	static volatile uint32_t *fb;
+
+	if (fb == 0 && vinfo.v_baseaddr != 0) {
+		fb = (volatile uint32_t *)vinfo.v_baseaddr;
+	}
+	if (fb == 0) {
+		return;
+	}
+	for (int y = 0; y < 48; y++) {
+		for (int x = 0; x < 48; x++) {
+			fb[(2200 + y) * 1080 + idx * 52 + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#else
+static inline void sweet_beacon(int idx, uint32_t color) { (void)idx; (void)color; }
+#endif
+
 void
 bsd_init(void)
 {
 	printf("SWEETDBG: bsd_init enter\n");
+	sweet_beacon(0, 0xff00ff00u);
 	struct uthread *ut;
 	vnode_t init_rootvnode = NULLVP;
 	struct proc_ro_data kernproc_ro_data = {
@@ -880,9 +914,11 @@ bsd_init(void)
 		netboot = (mountroot == netboot_mountroot);
 #endif
 
+		sweet_beacon(1, 0xff0000ffu);
 		printf("SWEETDBG: calling vfs_mountroot\n");
 		if (0 == (err = vfs_mountroot())) {
 			printf("SWEETDBG: vfs_mountroot ok\n");
+			sweet_beacon(2, 0xffffffffu);
 			break;
 		}
 		printf("SWEETDBG: vfs_mountroot failed rc=%d\n", err);
