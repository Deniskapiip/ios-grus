diff --git a/bsd/arm/vmparam.h b/bsd/arm/vmparam.h
--- a/bsd/arm/vmparam.h
+++ b/bsd/arm/vmparam.h
@@ -31,14 +31,14 @@
         (defined(KERNEL) && XNU_TARGET_OS_OSX)
 #define DFLSSIZ         (8*1024*1024 - 16*1024)
 #else
-#define DFLSSIZ         (1024*1024 - 16*1024)   /* initial stack size limit */
+#define DFLSSIZ         (16*1024*1024 - 16*1024)   /* initial stack size limit */
 #endif /* TARGET_OS_OSX .. || XNU_KERNEL_PRIVATE .. */
 #endif /* DFLSSIZ */
 #ifndef MAXSSIZ
 /* XXX stack size limit is a platform property: use getrlimit(2) */
 #if (defined(TARGET_OS_OSX) && (TARGET_OS_OSX != 0)) || \
         (defined(KERNEL) && XNU_TARGET_OS_OSX)
 #define MAXSSIZ         (64*1024*1024)          /* max stack size */
 #else
-#define MAXSSIZ         (1024*1024)             /* max stack size */
+#define MAXSSIZ         (64*1024*1024)          /* max stack size */
 #endif /* TARGET_OS_OSX .. || XNU_KERNEL_PRIVATE .. */
 #endif /* MAXSSIZ */
diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -6655,6 +6655,15 @@ create_unix_stack(vm_map_t map, load_result_t* load_result,
 	mach_vm_address_t       user_stack = load_result->user_stack;
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* Sweet/Grus: ensure ample committed user stack (16MB total, 8MB usable) to avoid chkstk fault */
+	if (load_result->user_stack_alloc_size < 16 * 1024 * 1024) {
+		load_result->user_stack_alloc_size = 16 * 1024 * 1024;
+	}
+	if (load_result->user_stack_size < 8 * 1024 * 1024) {
+		load_result->user_stack_size = 8 * 1024 * 1024;
+	}
+#endif
 	proc_lock(p);
 	p->user_stack = (uintptr_t)user_stack;
 	if (load_result->custom_stack) {
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1463,6 +1463,22 @@ handle_user_abort(arm_saved_state_t *state, uint32_t esr, vm_offset_t fault_addr
 			}
 		}
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		if (result != KERN_SUCCESS && result != KERN_ABORTED) {
+			uint64_t sp = (uint64_t)get_saved_state_sp(state);
+			if (vm_fault_addr >= (sp - 0x100000) && vm_fault_addr <= (sp + 0x100000)) {
+				mach_vm_offset_t alloc_addr = vm_fault_addr & ~0x3fffULL;
+				if (mach_vm_protect(map, alloc_addr, 0x4000, FALSE, VM_PROT_DEFAULT) == KERN_SUCCESS) {
+					result = vm_fault(map, vm_fault_addr, fault_type,
+					    FALSE, VM_KERN_MEMORY_NONE, THREAD_ABORTSAFE, NULL, 0);
+				}
+				if (result != KERN_SUCCESS) {
+					mach_vm_allocate_kernel(map, &alloc_addr, 0x4000, VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE, VM_KERN_MEMORY_NONE);
+					result = vm_fault(map, vm_fault_addr, fault_type,
+					    FALSE, VM_KERN_MEMORY_NONE, THREAD_ABORTSAFE, NULL, 0);
+				}
+			}
+		}
+#endif
 		if (thread->t_rr_state.trr_fault_state != TRR_FAULT_NONE) {
 			thread_reset_pcs_done_faulting(thread);
 		}
