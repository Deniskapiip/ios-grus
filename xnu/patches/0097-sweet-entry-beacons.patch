+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: one write-only colour square per startup entry, at the bottom of the
+ * screen. No framebuffer read and no console lock, so it keeps working even
+ * when the console stops printing.
+ */
+#include <console/video_console.h>
+/* the video console already mapped it: reuse, never map twice */
+extern struct vc_info vinfo;
+
+static int
+sweet_entry_seq(void)
+{
+	static int n;
+	return n < 20 ? n++ : 19;
+}
+
+static void
+sweet_entry_beacon(int idx, uint32_t color)
+{
+	static volatile uint32_t *fb;
+
+	if (fb == 0 && vinfo.v_baseaddr != 0) {
+		fb = (volatile uint32_t *)vinfo.v_baseaddr;
+	}
+	if (fb == 0) {
+		return;
+	}
+	idx %= 20;
+	for (int y = 0; y < 40; y++) {
+		for (int x = 0; x < 40; x++) {
+			fb[(2140 + y) * 1080 + idx * 44 + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#else
+static inline int sweet_entry_seq(void) { return 0; }
+static inline void sweet_entry_beacon(int idx, uint32_t color) { (void)idx; (void)color; }
+#endif
+
 static void
 kernel_startup_log(startup_subsystem_id_t subsystem)
 {
@@ -407,6 +449,7 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
