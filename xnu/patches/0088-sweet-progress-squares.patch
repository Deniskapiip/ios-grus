diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index 0941e5d..7819830 100755
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -228,11 +228,40 @@ kernel_bootstrap_log(const char *message)
 	kernel_debug_string_early(message);
 }
 
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* SWEET: draw a 40x40 colour square straight into the framebuffer. */
+static void
+sweetdbg_sq(int idx, int y0, uint32_t color)
+{
+	static volatile uint32_t *fb;
+	if (fb == NULL) {
+		fb = (volatile uint32_t *)ml_io_map((vm_offset_t)0x9c000000ULL,
+		    (vm_size_t)0x100000ULL);
+	}
+	if (fb == NULL) {
+		return;
+	}
+	for (int y = 0; y < 40; y++) {
+		for (int x = 0; x < 40; x++) {
+			fb[(y0 + y) * 1080 + idx * 44 + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#else
+static inline void sweetdbg_sq(int idx, int y0, uint32_t color) { (void)idx; (void)y0; (void)color; }
+#endif
+
 static inline void
 kernel_bootstrap_thread_log(const char *message)
 {
 	if (startup_phase >= STARTUP_SUB_KPRINTF) {
 		kprintf("SWEETDBG: kbt %s\n", message);
+		{
+			static int sweetdbg_step;
+			sweetdbg_sq(sweetdbg_step++ % 20, 1200, 0xff00ff00u);
+		}
 	}
 	kernel_debug_string_early(message);
 }
@@ -378,6 +407,7 @@ kernel_startup_log(startup_subsystem_id_t subsystem)
 		kernel_bootstrap_log(names[subsystem]);
 		if (startup_phase >= STARTUP_SUB_KPRINTF) {
 			kprintf("SWEETDBG: phase %s\n", names[subsystem]);
+			sweetdbg_sq((int)subsystem, 1100, 0xff0000ffu);
 		}
 	}
 	logged = subsystem;
