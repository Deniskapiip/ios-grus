 #define TOUCH_FTS        2
+#define TOUCH_GOODIX_GTX8 3
 /* GT9896 is Yellowstone in Xiaomi sweet-r-oss, not the Berlin protocol. */
 #define GOODIX_PID_REG   0x4022u
 #define GOODIX_EVENT_REG 0x4180u
 #define GOODIX_HEAD_LEN  8u
 #define GOODIX_POINT_LEN 8u
+/* GT9886/GT9889 (GTx8): report block = 2 header bytes, n*8 coordinate bytes,
+ * 2 checksum bytes. Byte 0 is the event state (0x80 = touch), byte 1 low
+ * nibble is the contact count; a contact is id@0, x lo/hi@1/2, y lo/hi@3/4. */
+#define GOODIX_GTX8_REG  0x824eu
+#define GOODIX_GTX8_POINT 8u
+#define GOODIX_GTX8_HEAD 2u
 
 #define SE_STATUS       0x040u
 #define SE_MCLK         0x048u
