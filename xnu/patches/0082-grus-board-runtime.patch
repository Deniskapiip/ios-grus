@@ -440,6 +452,69 @@ touch_goodix(void)
 	return err;
 }
 
+/*
+ * Goodix GT9886/GT9889 (GTx8 family, grus). Register 0x824e returns the event
+ * byte, the touch state and the first contact; further contacts follow at +12
+ * (8 bytes each) and the last two bytes are the 8-bit checksum that makes the
+ * whole report sum to zero (Xiaomi goodix_ts_i2c.c). The handshake is a single
+ * 0x00 write back to 0x824e.
+ */
+static int
+touch_goodix_gtx8(void)
+{
+	uint8_t buf[GOODIX_GTX8_HEAD + GOODIX_GTX8_POINT * TOUCH_MAX + 2];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(0x5d, GOODIX_GTX8_REG, true, buf,
+	    GOODIX_GTX8_HEAD + GOODIX_GTX8_POINT + 2);
+	if (err) {
+		return err;
+	}
+	if (!(buf[0] & 0x80u)) {
+		/* Request/gesture events are not serviced: do not acknowledge. */
+		return (buf[0] & 0x40u) ? ENOTSUP : 0;
+	}
+	unsigned n = buf[1] & 15u;
+	if (n == 0 || n > TOUCH_MAX) {
+		return EIO;
+	}
+	unsigned total = GOODIX_GTX8_HEAD + n * GOODIX_GTX8_POINT + 2;
+	if (n > 1) {
+		err = touch_read(0x5d, GOODIX_GTX8_REG + GOODIX_GTX8_HEAD +
+		    GOODIX_GTX8_POINT, true, buf + GOODIX_GTX8_HEAD + GOODIX_GTX8_POINT,
+		    (n - 1) * GOODIX_GTX8_POINT + 2);
+		if (err) {
+			return err;
+		}
+	}
+	unsigned sum = 0;
+	for (unsigned i = 0; i < total; ++i) {
+		sum += buf[i];
+	}
+	if ((sum & 0xffu) != 0) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + GOODIX_GTX8_HEAD + i * GOODIX_GTX8_POINT;
+		unsigned id = p[0] & 0x0fu;
+		unsigned px = (unsigned)p[1] | ((unsigned)p[2] << 8);
+		unsigned py = (unsigned)p[3] | ((unsigned)p[4] << 8);
+		if (id >= TOUCH_MAX || (mask & (1u << id)) || px > 1079 || py > 2339) {
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	const uint8_t ack[3] = {(uint8_t)(GOODIX_GTX8_REG >> 8),
+	    (uint8_t)(GOODIX_GTX8_REG & 0xffu), 0};
+	err = touch_msg(0x5d, ack, sizeof(ack), NULL, 0, false);
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	return err;
+}
